{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ws.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/ws",
      "dest": "api/ws.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
